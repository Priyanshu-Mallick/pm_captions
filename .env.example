# Sentry crash/error reporting DSN.
# Get this from your Sentry project: Settings → Projects → <project> → Client Keys (DSN).
# Leave empty to disable error reporting (e.g. local development).
SENTRY_DSN=

# Master switch for the Pro subscription feature (Pro caption styles, paywall,
# badges, Settings Pro card, RevenueCat itself). Set to "true" only when ready
# to ship Pro — until then it stays fully hidden and the app behaves exactly
# as if none of this code existed.
PRO_FEATURE_ENABLED=false

# RevenueCat public SDK keys (https://app.revenuecat.com → Project → API keys).
# Only read when PRO_FEATURE_ENABLED=true. Leave empty to run without
# subscriptions: the app starts normally, the paywall shows an "unavailable"
# state, and everything free keeps working.
REVENUECAT_APPLE_KEY=
REVENUECAT_GOOGLE_KEY=

# Entitlement identifier configured in RevenueCat that grants Pro access.
REVENUECAT_ENTITLEMENT_ID=pro_access
